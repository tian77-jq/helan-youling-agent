.photo-page{min-height:100vh;padding:28rpx 28rpx 70rpx;box-sizing:border-box;background:linear-gradient(180deg,#edf2ed,#f8efe1);color:#342e29}.photo-hero{padding:36rpx 30rpx;border-radius:32rpx;background:linear-gradient(145deg,#214d4b,#3f7166);color:#fff}.kicker{font-size:19rpx;letter-spacing:3rpx;color:#e7d2a7}.title{margin-top:13rpx;font-size:46rpx;font-weight:900}.subtitle{margin-top:12rpx;color:rgba(255,255,255,.78);font-size:24rpx;line-height:1.65}.privacy{margin-top:18rpx;padding:13rpx 16rpx;border-radius:14rpx;background:rgba(255,255,255,.1);font-size:20rpx;line-height:1.5}.upload-card{position:relative;height:450rpx;margin-top:24rpx;overflow:hidden;border:2rpx dashed #bfa989;border-radius:30rpx;background:#fffaf3}.upload-card>image{width:100%;height:100%}.upload-empty{display:flex;height:100%;align-items:center;justify-content:center;flex-direction:column;color:#6d5e50;font-size:27rpx}.upload-empty .camera{font-size:72rpx}.upload-empty text{max-width:480rpx;margin-top:12rpx;color:#9b8d80;font-size:21rpx;text-align:center}.recognizing{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;flex-direction:column;background:rgba(27,50,47,.84);color:#fff;font-size:24rpx}.spinner{margin-bottom:12rpx;font-size:62rpx;animation:spin 1.5s linear infinite}@keyframes spin{to{transform:rotate(360deg)}}.choose-btn,.trip-btn{margin-top:18rpx;border-radius:999rpx;background:#27665f;color:#fff;font-size:27rpx;font-weight:800}.choose-btn:after,.trip-btn:after{border:0}.error-card{margin-top:18rpx;padding:20rpx;border-radius:18rpx;background:#fff0e2;color:#955c37;font-size:23rpx;line-height:1.6}.error-card button{margin-top:12rpx;border-radius:999rpx;background:#8b5a2b;color:#fff;font-size:23rpx}.result-card{margin-top:28rpx;padding:28rpx;border-radius:30rpx;background:#fffaf3;box-shadow:0 10rpx 28rpx rgba(63,48,34,.1)}.result-label{color:#a06d3d;font-size:20rpx;letter-spacing:2rpx}.result-name{margin-top:8rpx;font-size:39rpx;font-weight:900}.confidence{margin-top:8rpx;color:#7d7064;font-size:22rpx}.tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:15rpx}.tags text{padding:8rpx 13rpx;border-radius:999rpx;background:#eee1ce;color:#795635;font-size:20rpx}.agent-box{margin-top:22rpx;padding:22rpx;border-radius:22rpx;background:linear-gradient(135deg,#edf2e7,#f6e7cc)}.agent-head{display:flex;gap:14rpx;align-items:center;font-size:26rpx;font-weight:800}.agent-head>text{font-size:48rpx}.agent-head view text{color:#807365;font-size:19rpx;font-weight:400}.agent-copy{margin-top:16rpx;color:#544b43;font-size:24rpx;line-height:1.75}.mode-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:18rpx}.mode-grid button{margin:0;border-radius:16rpx;background:#f0e4d4;color:#755335;font-size:22rpx}.mode-grid button:after{border:0}.official-note{margin-top:18rpx;color:#9a6c42;font-size:20rpx;line-height:1.6}.knowledge-section{margin-top:34rpx}.section-title{margin-bottom:18rpx;font-size:32rpx;font-weight:900}.knowledge-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx}.knowledge-card{overflow:hidden;border-radius:20rpx;background:#fffaf3;font-size:23rpx;font-weight:700}.knowledge-card image{width:100%;height:140rpx}.knowledge-card view{padding:14rpx}
