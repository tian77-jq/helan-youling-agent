<view class="page">
  <view class="hero role-hero" style="background:linear-gradient(145deg,{{role.color}},#6d4530)"><image src="{{role.image}}" mode="aspectFit"></image><view class="hero-title">{{role.name}}</view><view class="hero-sub">{{role.title}}</view><view class="slogan">{{story.title}}</view></view>
  <view wx:if="{{story}}" class="card story-bible-card"><view class="story-kicker">宁夏故事宇宙 · {{story.theme}}</view><view class="story-hook">{{story.hook}}</view><block wx:for="{{storyLevels}}" wx:key="level"><view class="story-level"><view class="story-level-no">0{{item.level}}</view><view><view class="label">{{item.label}} · {{item.title}}</view><view class="muted">{{item.text}}</view></view></view></block><button class="btn btn-full" bindtap="recommend">把这个故事变成路线 →</button><button class="btn btn-full story-create-btn" bindtap="openCreate">把这个故事变成作品 →</button><button class="story-imprint-btn" bindtap="earnImprint">{{imprint?'已获得：'+imprint.name:'收下这枚数字探索印记'}}</button></view>
  <view class="card story-avatar-card"><view class="section-title">让它讲自己的故事</view><view class="story-avatar-row"><image src="{{storyAvatar.characterProfile.image}}" mode="aspectFit"></image><view><view class="pet-answer-title">{{storyAvatar.characterProfile.name}} · AI数字人格</view><view class="avatar-status-chip">{{storyAvatar.avatarState==='SPEAKING'?'正在讲解':'字幕讲解'}}</view></view></view><view class="story-caption">{{storyAvatar.speakText}}</view><view class="story-actions"><button bindtap="listenStory">{{storyAvatar.avatarState==='SPEAKING'?'■ 停止讲解':'🔊 听我讲故事'}}</button><button class="ghost" bindtap="stopStory">停止</button></view><view class="ai-label">AI生成/合成内容 · 原创IP数字讲解员</view></view>
  <view class="card section"><view class="section-title">角色档案</view><view class="label">性格</view><view class="muted">{{role.personality}}</view><view class="label">文化寓意</view><view class="muted">{{role.culturalMeaning}}</view><view class="label">适合人群</view><view class="muted">{{role.targetUsers}}</view></view>
  <view class="section"><view class="section-title">相关文创概念</view><view class="product-grid"><block wx:for="{{recommended}}" wx:key="id"><view class="card product-tile" data-id="{{item.id}}" bindtap="openProduct"><image src="{{item.image}}" mode="aspectFit"></image><view class="product-name">{{item.name}}</view><view class="muted small">{{item.status}}</view></view></block></view></view><button class="btn btn-full" bindtap="recommend">让 AI 为我推荐伴手礼</button>
  <view wx:if="{{voiceSheetVisible}}" class="voice-sheet-mask" catchtap="closeVoiceSheet"><view class="voice-sheet" catchtap="noop"><view class="voice-sheet-orb">{{role.animal}}</view><view class="voice-sheet-title">{{voiceSheetTitle}}</view><view class="voice-sheet-body">{{voiceSheetBody}}</view><button class="btn btn-full" bindtap="continueVoiceChat">继续和灵灵聊宁夏</button><button class="voice-sheet-secondary" bindtap="closeVoiceSheet">查看字幕讲解</button><button class="voice-sheet-quiet" bindtap="closeVoiceSheet">知道了</button></view></view>
</view>
