.hero .ip-art{margin-bottom:20rpx}.role-hero image{width:100%;height:360rpx;background:#ffffff33;border-radius:24rpx}.product-grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.product-tile{padding:16rpx}.product-tile image{width:100%;height:220rpx;background:#f7f0e6;border-radius:20rpx}.product-name{font-weight:600;margin-top:10rpx}
.story-avatar-card{margin-top:24rpx;padding:24rpx}.story-avatar-row{display:flex;align-items:center;gap:18rpx}.story-avatar-row image{width:150rpx;height:150rpx;animation:storyFloat 3s ease-in-out infinite}.story-caption{margin-top:12rpx;padding:16rpx;border-radius:16rpx;background:#fff4e5;color:#544b43;font-size:24rpx;line-height:1.7}.story-actions{display:flex;gap:12rpx;margin-top:14rpx}.story-actions button{flex:1}.story-actions .ghost{background:#eee2d4;color:#765d49}.avatar-status-chip{display:inline-block;margin-top:10rpx;padding:6rpx 12rpx;border-radius:999rpx;background:#f2e6d4;color:#785b3f;font-size:21rpx}.ai-label{text-align:center;margin-top:12rpx;color:#9b8774;font-size:21rpx}@keyframes storyFloat{50%{transform:translateY(-6rpx)}}
.story-bible-card{margin-top:24rpx;padding:24rpx;background:linear-gradient(145deg,#fff8ec,#f1e2c7)}.story-kicker{color:#8b5a2b;font-size:21rpx}.story-hook{margin:14rpx 0 18rpx;font-size:30rpx;font-weight:800;color:#4b392b;line-height:1.5}.story-level{display:flex;gap:16rpx;padding:16rpx 0;border-top:1rpx solid rgba(139,90,43,.12)}.story-level-no{width:46rpx;height:46rpx;line-height:46rpx;text-align:center;border-radius:50%;background:#7b5a8e;color:#fff;flex:none;font-weight:700}.story-level .label{margin-bottom:6rpx}
.story-create-btn{margin-top:12rpx;background:#7b5a8e;color:#fff8ec}
.voice-sheet-mask{position:fixed;left:0;right:0;top:0;bottom:0;background:rgba(45,34,26,.34);z-index:99;display:flex;align-items:flex-end}.voice-sheet{width:100%;box-sizing:border-box;padding:34rpx 30rpx 42rpx;background:#fff8ee;border-radius:32rpx 32rpx 0 0;animation:voiceSheetIn .22s ease-out}.voice-sheet-orb{width:74rpx;height:74rpx;line-height:74rpx;text-align:center;border-radius:50%;background:#ead8bb;font-size:38rpx}.voice-sheet-title{margin-top:18rpx;font-size:34rpx;font-weight:800;color:#4b392b}.voice-sheet-body{margin:12rpx 0 22rpx;color:#725e4c;font-size:25rpx;line-height:1.7}.voice-sheet-secondary,.voice-sheet-quiet{width:100%;margin-top:12rpx;background:transparent;color:#7b5a8e}.voice-sheet-quiet{color:#9a8774}@keyframes voiceSheetIn{from{transform:translateY(100%);opacity:.7}to{transform:translateY(0);opacity:1}}
