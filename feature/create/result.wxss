.create-result{min-height:100vh;padding:28rpx 28rpx 70rpx;background:linear-gradient(180deg,#f8ecda,#f7f1e7 54%,#e9f0eb);color:#403328}.result-head{padding:26rpx 4rpx 20rpx}.eyebrow{font-size:18rpx;letter-spacing:3rpx;color:#a17445}.result-title{margin-top:12rpx;font-size:48rpx;font-weight:900}.result-sub{margin-top:7rpx;color:#8b7762;font-size:23rpx}.art-card{overflow:hidden;border-radius:30rpx;background:#fffaf3;box-shadow:0 16rpx 34rpx rgba(73,52,31,.14)}.art-image-wrap{position:relative}.art-image{display:block;width:100%;height:720rpx;background:#e5d7c1}.ai-content-mark{position:absolute;right:18rpx;bottom:18rpx;padding:10rpx 16rpx;border-radius:999rpx;background:rgba(0,0,0,.68);color:#fff;font-size:20rpx}.art-label{padding:16rpx 20rpx;color:#8c6948;font-size:21rpx}.culture-card{margin-top:20rpx;padding:23rpx;border-radius:24rpx;background:#174d4c;color:#fff8ec}.culture-kicker{font-size:18rpx;letter-spacing:3rpx;color:#e5c999}.culture-title{margin-top:9rpx;font-size:29rpx;font-weight:900}.culture-copy{margin-top:10rpx;color:rgba(255,248,236,.8);font-size:23rpx;line-height:1.6}.pet-credit{margin-top:15rpx;color:#f0d4a0;font-size:21rpx}.mock-note{margin-top:16rpx;padding:15rpx 18rpx;border-radius:16rpx;background:#fff2dc;color:#92724e;font-size:20rpx;line-height:1.5}.action-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:20rpx}.action-grid button{border:0;border-radius:999rpx;background:#fffaf3;color:#855a32;font-size:23rpx}.action-grid button:after{border:0}.secondary-btn{margin-top:18rpx;border-radius:999rpx;background:#e7d9c5;color:#775737;font-size:24rpx}.secondary-btn:after{border:0}.mark-canvas{position:fixed;left:-10000px;top:-10000px;pointer-events:none}
.ai-content-mark{right:auto;left:18rpx;top:18rpx;bottom:auto;max-width:70%;box-sizing:border-box;line-height:1.35;overflow-wrap:anywhere}.composition-overlay{position:absolute;left:0;right:0;bottom:0;box-sizing:border-box;padding:100rpx 26rpx 26rpx;background:linear-gradient(180deg,transparent,rgba(0,0,0,.82));color:#fff;direction:inherit;text-align:start}.composition-title{font-size:34rpx;font-weight:900;line-height:1.35;overflow-wrap:anywhere}.composition-meta,.composition-quote,.composition-date{margin-top:8rpx;font-size:21rpx;line-height:1.45;overflow-wrap:anywhere;word-break:normal}.action-grid button,.secondary-btn{box-sizing:border-box;min-width:0;height:auto;min-height:82rpx;padding:12rpx 18rpx;line-height:1.35;white-space:normal;overflow-wrap:anywhere;word-break:normal}.action-grid button{font-size:22rpx}
