.create-page{min-height:100vh;padding:28rpx 28rpx 70rpx;background:linear-gradient(180deg,#f8ecda,#f7f1e7 52%,#eaf1ec);color:#403328}.create-hero{padding:38rpx 30rpx;border-radius:34rpx;background:linear-gradient(145deg,#154c4b,#296e69 62%,#a47743);color:#fff;box-shadow:0 18rpx 38rpx rgba(30,73,69,.2)}.eyebrow{font-size:18rpx;letter-spacing:3rpx;color:#e7d1a8}.hero-title{margin-top:18rpx;font-size:62rpx;font-weight:900;letter-spacing:4rpx}.hero-sub{margin-top:2rpx;font-size:30rpx;color:#f1d6a5;letter-spacing:3rpx}.hero-copy{margin-top:24rpx;color:rgba(255,255,255,.86);font-size:25rpx;line-height:1.7}.hero-badge{display:inline-block;margin-top:22rpx;padding:10rpx 16rpx;border:1rpx solid rgba(255,255,255,.3);border-radius:999rpx;font-size:20rpx;color:#fff5df}.quota-card{display:flex;align-items:center;justify-content:space-between;margin-top:22rpx;padding:22rpx 26rpx;border-radius:24rpx;background:#fffaf2;box-shadow:0 8rpx 24rpx rgba(83,60,34,.08)}.quota-label{color:#95734f;font-size:21rpx}.quota-number{margin-top:4rpx;color:#8e5b2e;font-size:50rpx;font-weight:900}.quota-number text{font-size:22rpx;font-weight:500}.quota-note{text-align:right;color:#8d8072;font-size:21rpx;line-height:1.6}.section-head{display:flex;justify-content:space-between;align-items:flex-end;margin:32rpx 4rpx 18rpx}.section-title{font-size:34rpx;font-weight:900}.section-note{margin-top:7rpx;color:#a1815e;font-size:21rpx}.scene-grid{display:grid;grid-template-columns:1fr 1fr;gap:16rpx}.scene-card{min-height:230rpx;padding:22rpx;border-radius:26rpx;background:#fffaf3;box-shadow:0 9rpx 24rpx rgba(83,60,34,.08);box-sizing:border-box}.scene-card.gold{background:linear-gradient(145deg,#fff9ed,#f2dfb7)}.scene-card.blue{background:linear-gradient(145deg,#f1f7f4,#d7e9df)}.scene-card.ink{background:linear-gradient(145deg,#f3eee8,#ded3c5)}.scene-card.green{background:linear-gradient(145deg,#f1f5e8,#dce8c8)}.scene-card.red{background:linear-gradient(145deg,#fff2e8,#f0d6bf)}.scene-icon{font-size:42rpx}.scene-title{margin-top:13rpx;font-size:27rpx;font-weight:900;line-height:1.35}.scene-copy{margin-top:8rpx;color:#806f5f;font-size:21rpx;line-height:1.45}.scene-link{margin-top:17rpx;color:#9a6938;font-size:20rpx;font-weight:700}.difference-card{margin-top:24rpx;padding:26rpx;border-radius:26rpx;background:#164b4b;color:#fff8eb}.difference-title{font-size:27rpx;font-weight:900}.difference-copy{margin-top:12rpx;color:rgba(255,248,235,.78);font-size:22rpx;line-height:1.65}.difference-tags{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:16rpx}.difference-tags text{padding:7rpx 12rpx;border-radius:999rpx;background:rgba(255,255,255,.14);font-size:19rpx;color:#f1d5a5}
