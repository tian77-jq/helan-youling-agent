d:#fff1d6}.story-input{width:100%;min-height:130rpx;padding:16rpx;border:1rpx solid #e1d0bb;border-radius:16rpx;box-sizing:border-box;color:#453a30;font-size:24rpx;line-height:1.55}.story-hint{margin-top:9rpx;color:#998a7a;font-size:19rpx}.generate-btn{margin-top:25rpx;border-radius:999rpx;background:linear-gradient(135deg,#9b6435,#d19a56);color:#fff;font-size:27rpx;font-weight:800}.generate-btn:after{border:0}.ai-disclosure{margin-top:16rpx;padding:16rpx 18rpx;border-radius:16rpx;background:#fff2dc;color:#715b45;font-size:20rpx;line-height:1.55}.quota-foot{margin-top:14rpx;color:#927f6d;text-align:center;font-size:20rpx}
