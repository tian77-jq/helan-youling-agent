.avatar-page{min-height:100vh;padding:32rpx;background:#f8f1e7;box-sizing:border-box}.avatar-card,.caption-card{background:#fffaf3;border-radius:28rpx;padding:30rpx;margin-bottom:24rpx}.avatar-card{text-align:center}.avatar-image{width:330rpx;height:330rpx;animation:float 3s ease-in-out infinite}.state-SPEAKING .avatar-image{animation:breathe .55s ease-in-out infinite alternate}.avatar-name{font-size:30rpx;font-weight:700;color:#5c4230}.avatar-state,.caption-label,.ai-label{color:#9b8774;font-size:23rpx;margin-top:12rpx}.caption-label{margin:0 0 14rpx}.ghost{background:#eee2d4;color:#765d49}.ai-label{text-align:center}@keyframes float{50%{transform:translateY(-8rpx)}}@keyframes breathe{to{transform:scale(1.04)}}
