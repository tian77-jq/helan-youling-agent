.memory-page{min-height:100vh;padding:28rpx 28rpx 70rpx;box-sizing:border-box;background:linear-gradient(180deg,#f3e6cf,#eef2e8);color:#342c25}.memory-head{padding:35rpx 30rpx;border-radius:32rpx;background:linear-gradient(145deg,#7b4e2b,#b37b43 60%,#245a55);color:#fff}.kicker{font-size:19rpx;letter-spacing:3rpx;color:#efd7aa}.title{margin-top:12rpx;font-size:43rpx;font-weight:900}.subtitle{margin-top:10rpx;color:rgba(255,255,255,.78);font-size:24rpx;line-height:1.6}.section-label{margin:30rpx 0 16rpx;font-size:29rpx;font-weight:900}.place-scroll{white-space:nowrap}.place-row{display:inline-flex;gap:14rpx}.place-card{width:225rpx;overflow:hidden;border:4rpx solid transparent;border-radius:22rpx;background:#fffaf3}.place-card.active{border-color:#2b6d64}.place-card image{width:225rpx;height:135rpx}.place-card view{padding:13rpx;overflow:hidden;text-overflow:ellipsis;font-size:22rpx;font-weight:700}.agent-row{display:grid;grid-template-columns:1fr;gap:12rpx}.agent-chip{display:flex;gap:14rpx;align-items:center;padding:17rpx 20rpx;border:2rpx solid transparent;border-radius:20rpx;background:#fffaf3}.agent-chip.active{border-color:#b77a3b;background:#fff4df}.agent-chip>text{font-size:45rpx}.agent-chip view view{font-size:25rpx;font-weight:800}.agent-chip view text{color:#8c7a67;font-size:19rpx}.note-input{width:100%;height:150rpx;padding:20rpx;border:1rpx solid #e0cdb2;border-radius:22rpx;background:#fffaf3;box-sizing:border-box;font-size:25rpx;line-height:1.6}.generate,.share{margin-top:20rpx;border-radius:999rpx;background:linear-gradient(135deg,#235d57,#337a6e);color:#fff;font-size:27rpx;font-weight:800}.generate:after,.share:after{border:0}.generated-area{margin-top:30rpx}.memory-card{position:relative;height:810rpx;overflow:hidden;border-radius:34rpx;background:#44372c;box-shadow:0 20rpx 45rpx rgba(54,39,26,.22)}.card-image{position:absolute;width:100%;height:100%}.card-mask{position:absolute;inset:0;background:linear-gradient(180deg,rgba(15,22,19,.05) 15%,rgba(20,22,18,.88) 68%,#17231f)}.card-copy{position:absolute;left:32rpx;right:32rpx;bottom:32rpx;color:#fff}.card-kicker{color:#e9d09f;font-size:18rpx;letter-spacing:3rpx}.card-place{margin-top:12rpx;font-size:48rpx;font-family:"STSong","Songti SC",serif;font-weight:900}.card-agent{margin-top:8rpx;color:#ead7b8;font-size:23rpx}.card-memory{margin-top:20rpx;white-space:pre-wrap;font-size:24rpx;line-height:1.72}.card-date{margin-top:20rpx;color:rgba(255,255,255,.58);font-size:19rpx}.action-grid{display:grid;grid-template-columns:1fr 1fr;gap:12rpx;margin-top:18rpx}.action-grid button{margin:0;border-radius:18rpx;background:#f0e2cf;color:#76502e;font-size:22rpx}.action-grid button:after{border:0}.share{background:linear-gradient(135deg,#8e5b2d,#c58a48)}.save-note{margin-top:14rpx;color:#8a7764;font-size:19rpx;line-height:1.5}
