<view class="page"><view wx:if="{{loading}}" class="empty"><view style="font-size:80rpx">✦</view><view class="section-title">AI正在生成设计推荐...</view><view class="muted">正在匹配IP故事、风格与创意场景</view></view><block wx:else><view class="hero"><view class="eyebrow">YOUR CREATIVE IP MATCH</view><view class="hero-title">{{result.ipName}}</view><view class="hero-sub">{{result.giftCombo}}</view></view><view class="card section"><view class="section-title">为什么推荐</view><view class="muted">{{result.reasonZh}}</view></view><view class="section"><view class="section-title">推荐设计</view><view class="product-grid"><block wx:for="{{recommended}}" wx:key="id"><view class="card product-tile" data-id="{{item.id}}" bindtap="openProduct"><image src="{{item.image}}" mode="aspectFit"></image><view class="product-name">{{item.name}}</view><view class="muted small">{{item.scene}}</view></view></block></view></view><view class="card"><view class="section-title">文化解释</view><view class="muted">{{result.cultureZh}}</view><view class="pill-row"><text class="tag" wx:for="{{result.tags}}" wx:key="*this">{{item}}</text></view></view><view class="card"><view class="section-title">双语祝福卡</view><view class="muted">{{result.blessingZh}}</view><view class="divider"></view><view class="muted">{{result.blessingEn}}</view></view><button class="btn btn-full" bindtap="intent">收藏设计</button><button class="btn btn-secondary btn-full" bindtap="favorite">收藏推荐</button><button class="btn btn-secondary btn-full" bindtap="shop">进入文创展厅</button><button class="btn btn-secondary btn-full" bindtap="again">重新推荐</button></block></view>
