.cultural-hero{padding:36rpx 30rpx;border-radius:34rpx;background:linear-gradient(135deg,#563d72,#315b68);color:#fff8ec;box-shadow:0 16rpx 36rpx rgba(58,48,79,.22)}.cultural-hero .title{margin:12rpx 0;font-size:44rpx;font-weight:800}.cultural-hero .subtitle{font-size:26rpx;line-height:1.7;color:rgba(255,248,236,.86)}.progress-card{margin-top:24rpx;background:#fff2d8}.level-card{display:flex;align-items:center;gap:20rpx;margin-top:18rpx;padding:22rpx}.level-no{font-size:40rpx;font-weight:900;color:#9b6c39}.level-main{flex:1}.level-title{font-size:30rpx;font-weight:800;color:#3e2b20}.level-arrow{font-size:34rpx;color:#9b6c39}.drama-unlock{margin-top:24rpx;background:linear-gradient(135deg,#fff5df,#f0dfbd)}.drama-scene{margin-top:18rpx;padding:18rpx;border-radius:20rpx;background:rgba(255,255,255,.65)}.drama-dialogue{font-size:27rpx;line-height:1.7;color:#5a4330;margin-bottom:14rpx}.drama-scene button,.option{margin:12rpx 0 0;padding:16rpx 18rpx;border-radius:18rpx;background:#fffaf1;color:#68482a;text-align:left;font-size:25rpx;line-height:1.5;border:1rpx solid rgba(139,90,43,.14)}.drama-scene button:after,.option:after{border:0}.option.selected{color:#fff;background:#8b5a2b}.quest-panel{margin-top:24rpx}.agent-line{color:#8b5a2b;font-size:27rpx;font-weight:700}.task-count{text-align:right;color:#9a8874;font-size:22rpx;margin:12rpx 4rpx}.task-card{padding:26rpx}.task-prompt{font-size:31rpx;font-weight:700;line-height:1.6;color:#3d2b20;margin-bottom:18rpx}.task-card textarea{width:100%;min-height:180rpx;padding:18rpx;box-sizing:border-box;background:#fbf4e9;border-radius:18rpx;font-size:26rpx}.feedback-box{margin-top:22rpx;padding:20rpx;border-radius:20rpx;background:#f2e6d0;color:#614a35;line-height:1.7}.score{font-size:31rpx;font-weight:800;color:#8b5a2b;margin-bottom:8rpx}.warning{margin-top:10rpx;color:#9b4f30}
