<view class="page cultural-page"><view class="cultural-hero"><view class="eyebrow">HELAN SPIRITS · CULTURAL QUEST</view><view class="title">灵境 · AI文化闯关</view><view class="subtitle">跟着三只萌宠，看看你能不能成为宁夏文化推介官。</view></view><view wx:if="{{!level}}"><view class="progress-card card"><view class="section-title">你的文化成长</view><view class="muted">已完成 {{progress.completedLevels.length}} / 4 关 · 获得 {{progress.badges.length}} 枚徽章</view></view><view class="level-card card" wx:for="{{levels}}" wx:key="id" data-level="{{item.id}}" bindtap="startLevel"><view class="level-no">0{{item.id}}</view><view class="level-main"><view class="level-title">{{item.title}} <text wx:if="{{progress.completedLevels.indexOf(item.id)>-1}}">✓</text></view><view class="muted">{{item.subtitle}}</view><view class="small muted">3 个情境任务 · {{item.badgeName}}</view></view><view class="level-arrow">→</view></view><view class="card drama-unlock" wx:if="{{dramaUnlocked}}"><view class="section-title">AI文化微剧场</view><view class="muted">《{{drama.title}}》 · {{drama.duration}}</view><view wx:if="{{dramaScene}}" class="drama-scene"><view class="drama-dialogue">{{dramaScene.character}}：{{dramaScene.dialogue}}</view><button wx:for="{{dramaScene.choices}}" wx:key="id" data-choice="{{item.id}}" bindtap="dramaChoose">{{item.text}}</button></view><button wx:if="{{dramaDone}}" class="btn btn-secondary btn-full" bindtap="shareDrama">分享这段文化对话</button></view><button class="btn btn-secondary btn-full" bindtap="goMy">去“我的”查看文化徽章</button></view><view wx:else class="quest-panel"><view class="agent-line">{{agent.avatar}} {{agent.name}} · {{agent.role}}</view><view class="task-count">任务 {{taskIndex+1}} / {{level.tasks.length}}</view><view class="card task-card"><view class="task-prompt">{{task.prompt}}</view><view wx:if="{{task.type==='choice'}}"><button wx:for="{{task.options}}" wx:key="*this" class="option {{selected===index?'selected':''}}" data-index="{{index}}" bindtap="choose">{{item}}</button></view><textarea wx:if="{{task.type==='open'}}" value="{{answer}}" bindinput="input" placeholder="用你的话回答，事实准确比华丽更重要"></textarea><button class="btn btn-full" bindtap="submit" disabled="{{task.type==='choice'&&selected<0}}">提交回答</button><view wx:if="{{score}}" class="feedback-box"><view class="score">建议评分 {{score.score}} / 100</view><view>{{feedback}}</view><view wx:for="{{score.unsupportedClaims}}" wx:key="*this" class="warning">{{item}}</view><button class="btn btn-secondary btn-full" bindtap="next">{{taskIndex+1===level.tasks.length?'领取关卡徽章':'继续下一个任务'}}</button></view></view></view></view>
