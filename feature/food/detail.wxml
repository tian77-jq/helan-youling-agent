<view class="page" wx:if="{{item}}"><image class="cover" src="{{item.image}}" mode="aspectFill"></image><view class="title">{{item.name['zh-CN']}}</view><view class="pill-row"><text class="tag">{{item.city}}</text><text class="tag">{{item.taste}}</text></view><view class="card section"><view class="section-title">风味与文化</view><view class="muted">{{item.intro}}</view><view class="label">文化场景</view><view class="muted">{{item.culture}}</view><view class="label">适合谁</view><view class="muted">{{item.suitableFor}}</view></view><view class="card agent-card"><view class="section-title">{{agent.avatar}} {{agent.name}} · {{agent.role}}</view><view class="muted">问我这道味道如何放进你的宁夏旅程。</view></view><button class="btn btn-full" bindtap="ask">问萌宠</button><button class="btn btn-secondary btn-full" bindtap="add">加入我的美食路线</button><button class="btn btn-secondary btn-full" bindtap="addTrip">加入 AI 行程</button><button class="btn btn-secondary btn-full" bindtap="goHome">返回首页</button></view>
