@import "styles/variables.wxss";
@import "styles/theme.wxss";

/* One-shot entry choreography: the controller changes data-motion on every onShow. */
[data-motion^="MOUNTAIN-ENTRY"] .ningxia-hero,[data-motion^="MOUNTAIN-ENTRY"] .trip-hero{animation:sceneEntryRise 900ms cubic-bezier(.22,.61,.36,1) both}
[data-motion^="RIVER-ENTRY"] .discover-hero{animation:sceneEntryRiver 900ms cubic-bezier(.22,.61,.36,1) both}
[data-motion^="DESERT-ENTRY"] .dune-exhibition{animation:sceneEntryDune 1000ms ease both}
[data-motion^="STAR-ENTRY"] .star-atlas-hero{animation:sceneEntryStar 1100ms ease both}
[data-motion^="SHAPOTOU-ENTRY"] .shapotou-sequence{animation:sceneEntryShapotou 1200ms ease both}
[data-motion^="STAR-PORTAL"] .star-map{animation:starPortalSwitch 820ms cubic-bezier(.2,.8,.2,1) both}
@keyframes starPortalSwitch{0%{opacity:.55;transform:translateY(24rpx) scale(.97)}55%{opacity:1;transform:translateY(-5rpx) scale(1.01)}100%{transform:translateY(0) scale(1)}}
@keyframes sceneEntryRise{from{opacity:.35;transform:translateY(28rpx)}to{opacity:1;transform:translateY(0)}}
@keyframes sceneEntryRiver{from{opacity:.35;transform:translateX(-24rpx)}to{opacity:1;transform:translateX(0)}}
@keyframes sceneEntryDune{from{opacity:.35;transform:translateY(32rpx) scale(.98)}to{opacity:1;transform:translateY(0) scale(1)}}
@keyframes sceneEntryStar{from{opacity:.35;transform:scale(.94)}to{opacity:1;transform:scale(1)}}
@keyframes sceneEntryShapotou{from{opacity:.35;transform:translateX(24rpx)}to{opacity:1;transform:translateX(0)}}
button,.btn,.pill,.portal,.world-card,.persona-discovery-card,.card,.itinerary-card,.memory-star,.atlas-star{transition:transform 220ms cubic-bezier(.22,.61,.36,1),box-shadow 220ms ease,filter 220ms ease,background-color 220ms ease}
button:active,.btn:active,.pill:active,.portal:active,.world-card:active,.persona-discovery-card:active,.card:active,.itinerary-card:active{transform:scale(.975);filter:saturate(1.08)}
.ningxia-hero:after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(112deg,transparent 35%,rgba(255,247,218,.22) 49%,transparent 63%);transform:translateX(-120%);animation:heroLightSweep 10s 1.2s ease-in-out infinite}
.hero-entering:after{animation:heroLightSweep 2.2s .1s ease-out both}
@keyframes heroLightSweep{0%,22%{transform:translateX(-120%)}58%,100%{transform:translateX(120%)}}
.discover-hero{position:relative;overflow:hidden}.discover-hero:after{content:"";position:absolute;left:-12%;right:-12%;bottom:0;height:5rpx;background:linear-gradient(90deg,transparent,#e5c27d,#2d7180,transparent);transform-origin:left center;animation:riverLineDraw 4.8s ease-in-out infinite}
@keyframes riverLineDraw{0%{transform:scaleX(.15);opacity:.25}48%{transform:scaleX(1);opacity:1}100%{transform:scaleX(.15);opacity:.25}}
.dune-exhibition:after{content:"";position:absolute;z-index:1;left:-20%;top:0;width:30%;height:100%;background:linear-gradient(90deg,transparent,rgba(255,239,193,.24),transparent);transform:skewX(-18deg);animation:duneLightPass 7s 1.1s ease-in-out infinite}
@keyframes duneLightPass{0%,40%{transform:translateX(-120%) skewX(-18deg)}72%,100%{transform:translateX(460%) skewX(-18deg)}}
.star-atlas-hero:after{content:"✦  ·  ✦     ·   ✦";position:absolute;right:26rpx;top:28rpx;color:rgba(255,231,168,.5);letter-spacing:12rpx;font-size:20rpx;animation:starFieldDrift 8s ease-in-out infinite}
@keyframes starFieldDrift{50%{transform:translateY(12rpx);opacity:.55}100%{transform:translateY(0);opacity:1}}
.workspace-pulse .workspace-task:not([hidden]),.workspace-pulse .workspace-creation:not([hidden]){animation:workspaceSwap 420ms cubic-bezier(.22,.61,.36,1) both}
@keyframes workspaceSwap{from{opacity:.2;transform:translateY(18rpx)}to{opacity:1;transform:translateY(0)}}
.timeline-item:nth-child(1){animation-delay:40ms}.timeline-item:nth-child(2){animation-delay:80ms}.timeline-item:nth-child(3){animation-delay:120ms}.timeline-item:nth-child(4){animation-delay:160ms}.timeline-item:nth-child(5){animation-delay:200ms}
.result-area .timeline-item{animation:timelineReveal 520ms cubic-bezier(.22,.61,.36,1) both}@keyframes timelineReveal{from{opacity:0;transform:translateX(-18rpx)}to{opacity:1;transform:translateX(0)}}
.memory-star:active,.atlas-star:active{transform:scale(1.35);filter:brightness(1.3)}
[data-motion-mode="REDUCED"] .hero-landscape,[data-motion-mode="OFF"] .hero-landscape,[data-motion-mode="REDUCED"] .hero-heading,[data-motion-mode="OFF"] .hero-heading,.motion-reduced .ningxia-hero,.motion-off .ningxia-hero,.motion-reduced .discover-hero,.motion-off .discover-hero,.motion-reduced .dune-exhibition,.motion-off .dune-exhibition,.motion-reduced .star-atlas-hero,.motion-off .star-atlas-hero,.motion-reduced .workspace-task,.motion-off .workspace-task,.motion-reduced .workspace-creation,.motion-off .workspace-creation{animation:none!important;transition:none!important}
page{background:#f8f1e7;color:#352d27;font-family:Arial,"PingFang SC",sans-serif;font-size:28rpx}
.scene-strip{display:flex;align-items:center;gap:12rpx;margin:18rpx 0;color:#806b59;font-size:21rpx;letter-spacing:2rpx}.scene-strip:before{content:"";display:block;width:72rpx;height:10rpx;border-top:3rpx solid #2c746e;border-radius:50%;transform:skewX(-28deg)}
.page{padding:36rpx 32rpx 60rpx;box-sizing:border-box;min-height:100vh}
.hero{background:linear-gradient(145deg,#6d4530,#a87849 58%,#d8aa70);color:#fff;border-radius:34rpx;padding:42rpx 34rpx;position:relative;overflow:hidden;box-shadow:0 18rpx 40rpx #7c593522}
.hero:after{content:"⌁⌁⌁";position:absolute;right:14rpx;bottom:-35rpx;font-size:150rpx;color:#ffffff22;transform:rotate(-8deg)}
.eyebrow{font-size:22rpx;letter-spacing:4rpx;opacity:.82}.hero-title{font-size:68rpx;font-weight:800;margin:20rpx 0 10rpx}.hero-sub{font-size:25rpx;line-height:1.6;max-width:620rpx}.slogan{font-size:32rpx;font-weight:700;line-height:1.45;margin-top:28rpx}
.section{margin-top:38rpx}.section-head{display:flex;justify-content:space-between;align-items:end;margin-bottom:20rpx}.section-title{font-size:38rpx;font-weight:800}.section-note{font-size:22rpx;color:#927e6c}.card{background:#fffaf3;border-radius:24rpx;padding:26rpx;box-shadow:0 10rpx 28rpx #795b3e12;margin-bottom:20rpx}.muted{color:#8d8176;line-height:1.7}.small{font-size:23rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.entry{min-height:150rpx;padding:24rpx;border-radius:24rpx;color:#fff;display:flex;flex-direction:column;justify-content:space-between}.entry-name{font-size:30rpx;font-weight:700}.entry-desc{font-size:22rpx;opacity:.86}.blue{background:linear-gradient(135deg,#235172,#3f88a1)}.sand{background:linear-gradient(135deg,#a96e3f,#d9ae76)}.ink{background:linear-gradient(135deg,#443c39,#817066)}.olive{background:linear-gradient(135deg,#65704b,#9eaa75)}
.ip-card{display:flex;gap:22rpx;align-items:center}.ip-art{width:136rpx;height:136rpx;border-radius:40rpx;display:flex;align-items:center;justify-content:center;font-size:68rpx;flex:none}.ip-info{flex:1}.ip-name{font-size:32rpx;font-weight:800}.tag{display:inline-block;background:#f0e3d0;color:#8b5a2b;padding:8rpx 16rpx;border-radius:20rpx;font-size:21rpx;margin:12rpx 8rpx 0 0}.btn{border:0;border-radius:50rpx;background:#8b5a2b;color:#fff;font-size:28rpx;padding:22rpx 28rpx;line-height:1.2}.btn:after{border:0}.btn-secondary{background:#f1e3d2;color:#8b5a2b}.btn-blue{background:#255a78}.btn-full{width:100%;box-sizing:border-box;margin-top:18rpx}.link-btn{color:#8b5a2b;font-size:24rpx}.pill-row{display:flex;flex-wrap:wrap;gap:14rpx}.pill{border:2rpx solid #eadbc8;border-radius:40rpx;padding:16rpx 22rpx;color:#765f4b;background:#fffaf3;font-size:25rpx}.pill.active{background:#8b5a2b;border-color:#8b5a2b;color:#fff}.label{font-size:28rpx;font-weight:700;margin:26rpx 0 14rpx}.input{background:#fffaf3;border:2rpx solid #eadbc8;border-radius:18rpx;padding:20rpx;min-height:100rpx;box-sizing:border-box}.product{display:flex;gap:20rpx;align-items:center}.product-art{width:150rpx;height:150rpx;border-radius:22rpx;background:linear-gradient(145deg,#ead2ae,#a47b57);display:flex;align-items:center;justify-content:center;font-size:64rpx}.product-main{flex:1}.product-name{font-weight:800;font-size:30rpx}.price{color:#b46c36;font-weight:700;margin-top:10rpx}.stat-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.stat{background:#fffaf3;border-radius:22rpx;padding:24rpx}.stat-value{font-size:44rpx;font-weight:800;color:#285979}.stat-label{font-size:22rpx;color:#8d8176;margin-top:8rpx}.bar-line{display:flex;align-items:center;gap:14rpx;margin:16rpx 0}.bar-name{width:150rpx;font-size:23rpx}.bar{height:16rpx;flex:1;background:#eadfd2;border-radius:20rpx;overflow:hidden}.bar-fill{height:100%;background:linear-gradient(90deg,#7fa6af,#c18b55);border-radius:20rpx}.bar-num{width:40rpx;text-align:right;color:#8d8176;font-size:22rpx}.divider{height:2rpx;background:#eee1d2;margin:26rpx 0}.mountain{height:90rpx;margin:28rpx -32rpx -30rpx;background:linear-gradient(135deg,transparent 49%,#e3c9a7 50%,transparent 52%),linear-gradient(45deg,transparent 48%,#d3b188 50%,transparent 52%);background-size:150rpx 90rpx,190rpx 90rpx;opacity:.55}.empty{text-align:center;padding:70rpx 20rpx;color:#9c8d80}.warning{font-size:21rpx;color:#a27651;background:#fff0dc;padding:14rpx 18rpx;border-radius:14rpx;margin:14rpx 0}.title{font-size:48rpx;font-weight:800;margin:10rpx 0 12rpx}.subtitle{font-size:25rpx;color:#88776a;line-height:1.65}

.rtl{direction:rtl;text-align:right;font-family:sans-serif,Arial}.rtl button{text-align:center}.rtl input,.rtl textarea{direction:rtl;text-align:right}.rtl [dir='ltr']{direction:ltr;unicode-bidi:isolate}
page{font-family:-apple-system,BlinkMacSystemFont,"PingFang SC","Microsoft YaHei","Segoe UI",Arial,sans-serif}.en .persona-discovery-content,.en .trip-card-head>view,.en .home-story-hero,.en .onboarding-card{min-width:0}.en .persona-discovery-title,.en .persona-discovery-copy,.en .trip-card-title,.en .trip-card-kicker,.en .hero-subtitle,.en .home-story-title,.en .home-story-copy,.en .onboarding-title,.en .onboarding-copy{overflow-wrap:anywhere;word-break:normal}.en .persona-discovery-title{line-height:1.3}.en .trip-card-actions{flex-wrap:wrap}.en .trip-card-actions button,.en .trip-card-actions .resume-disabled{flex:1 1 42%;min-width:0;height:auto;min-height:76rpx;box-sizing:border-box;padding:12rpx 16rpx;line-height:1.35;white-space:normal;overflow-wrap:anywhere;word-break:normal}
.en button,.en .button,.en .btn,.en .pill{height:auto;min-height:72rpx;box-sizing:border-box;line-height:1.35;white-space:normal;overflow-wrap:anywhere;word-break:normal}.en .card,.en .card view,.en .card text{min-width:0}.en .card text,.en .card view,.en .title,.en .subtitle{overflow-wrap:anywhere;word-break:normal}
