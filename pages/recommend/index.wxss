.page {
  min-height: 100vh;
  padding: 32rpx 28rpx 60rpx;
  box-sizing: border-box;
  background: linear-gradient(180deg, #fff7ea 0%, #f7ead7 45%, #f3e0c3 100%);
  color: #2f2419;
}

.hero {
  padding: 34rpx 30rpx;
  border-radius: 34rpx;
  background: linear-gradient(135deg, #8b5a2b, #34495e);
  color: #fff8ec;
  box-shadow: 0 18rpx 42rpx rgba(97, 61, 30, 0.22);
}

.eyebrow {
  font-size: 22rpx;
  opacity: 0.78;
  letter-spacing: 2rpx;
  margin-bottom: 12rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.2;
  margin-bottom: 16rpx;
}

.subtitle {
  font-size: 26rpx;
  line-height: 1.75;
  color: rgba(255, 248, 236, 0.9);
}

.subtitle.dark {
  color: #5d4a38;
}

.section {
  margin-top: 28rpx;
}

.card {
  padding: 30rpx;
  border-radius: 30rpx;
  background: rgba(255, 252, 246, 0.95);
  box-shadow: 0 12rpx 30rpx rgba(86, 57, 30, 0.12);
  border: 1rpx solid rgba(139, 90, 43, 0.08);
}

.section-title {
  font-size: 31rpx;
  font-weight: 800;
  color: #342414;
  margin-bottom: 22rpx;
}

.option-wrap {
  display: flex;
  flex-wrap: wrap;
  gap: 18rpx;
}

.option {
  padding: 18rpx 24rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  color: #6b5845;
  background: #fff7ea;
  border: 1rpx solid rgba(139, 90, 43, 0.16);
}

.option.active {
  color: #fff8ec;
  background: linear-gradient(135deg, #8b5a2b, #c08a45);
  border-color: transparent;
  font-weight: 700;
}

.preview-line {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid rgba(139, 90, 43, 0.1);
}

.preview-line:last-child {
  border-bottom: none;
}

.preview-label {
  width: 120rpx;
  font-size: 26rpx;
  color: #7d6b58;
}

.preview-value {
  flex: 1;
  font-size: 27rpx;
  font-weight: 700;
  color: #8b5a2b;
}

.btn {
  margin: 26rpx 0 0;
  border-radius: 999rpx;
  font-size: 29rpx;
  font-weight: 700;
  border: none;
}

.btn-full {
  width: 100%;
}

.btn-primary {
  color: #fff8ec;
  background: linear-gradient(135deg, #8b5a2b, #c08a45);
}

.btn-secondary {
  color: #5a4632;
  background: #fff7ea;
  border: 1rpx solid rgba(139, 90, 43, 0.18);
}