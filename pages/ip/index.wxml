<view class="page discover-page river-scene {{isRtl?'rtl':''}} {{isEnglish?'en':''}}" dir="{{isRtl?'rtl':'ltr'}}" data-motion="{{motionToken}}" data-motion-mode="{{motionMode}}">
  <view class="discover-hero"><view class="scene-identity">{{ui.identity}}</view><view class="eyebrow">{{ui.eyebrow}}</view><view class="title">{{ui.title}}</view><view class="subtitle">{{ui.subtitle}}</view></view>
  <view class="discover-section-head"><view class="section-title">{{ui.start}}</view><view class="section-note">{{ui.startNote}}</view></view>
  <view class="world-grid compact-world-grid"><view wx:for="{{discoveryWorlds}}" wx:key="id" class="world-card world-{{item.id}} {{activeWorld.id===item.id?'active':''}}" data-id="{{item.id}}" bindtap="enterWorld"><text class="world-icon">{{item.icon}}</text><view class="world-title">{{item.label}}</view><view class="world-copy">{{item.copy}}</view><view class="world-actor">{{item.character}}</view></view></view>
  <view wx:if="{{activeWorld}}" class="world-action"><view><text>{{activeWorld.title}}</text><view>{{activeWorld.copy}}</view></view><button data-prompt="{{activeWorld.aiPrompt}}" bindtap="askPet">{{activeWorld.prompt}} →</button></view>
  <view class="wine-theme raised-route-theme" bindtap="startTrip"><view class="wine-theme-kicker">{{ui.landscapeTagline}}</view><view class="wine-theme-title">{{ui.routeTitle}}</view><view class="wine-theme-copy">{{ui.routeCopy}}</view><view class="wine-theme-action">{{ui.routeAction}} →</view></view>
  <view class="discover-section-head selected-head"><view><view class="section-title">{{ui.picks}}</view><view class="section-note">{{ui.picksNote}}</view></view></view>
  <scroll-view scroll-x class="discover-scene-scroll"><block wx:for="{{scenicCollabs}}" wx:key="id"><view class="discover-scene" data-id="{{item.id}}" bindtap="openScenic"><image src="{{item.image}}" mode="aspectFill" lazy-load></image><view class="discover-scene-name">{{item.scenicName}}</view><view class="muted small">{{item.tag}} · {{item.subtitle}}</view></view></block></scroll-view>
  <view class="discover-section-head"><view><view class="section-title">{{ui.taste}}</view><view class="section-note">{{ui.tasteNote}}</view></view></view>
  <block wx:for="{{foodCollabs}}" wx:key="id"><view class="card discover-food"><image src="{{item.image}}" mode="aspectFill" lazy-load></image><view class="discover-food-main"><view class="product-name">{{item.title}}</view><view class="muted small">{{item.subtitle}}</view><view class="discover-actions"><button data-id="{{item.foodId}}" catchtap="openFood">{{ui.more}}</button><button data-prompt="{{item.title}}有什么值得了解和注意的？" catchtap="askPet">{{ui.ask}}</button><button data-food="{{item.title}}" catchtap="addFood">{{ui.add}}</button></view></view></view></block>
</view>
