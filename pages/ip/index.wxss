.discover-hero{padding:34rpx 30rpx;border-radius:32rpx;background:linear-gradient(135deg,#174f50,#356f63);color:#fff8ec;box-shadow:0 16rpx 34rpx rgba(22,71,65,.2)}
.discover-hero .title{margin:10rpx 0;font-size:48rpx;font-weight:800}.discover-hero .subtitle{font-size:26rpx;line-height:1.65;color:rgba(255,248,236,.86)}
.discover-scene-scroll{white-space:nowrap;margin-left:-4rpx}.discover-scene{display:inline-block;vertical-align:top;width:300rpx;margin-right:18rpx;padding-bottom:16rpx}.discover-scene image{width:300rpx;height:190rpx;border-radius:24rpx;display:block;margin-bottom:12rpx}.discover-scene-name{font-size:27rpx;font-weight:700;color:#3d2c1e}.discover-food{display:flex;gap:20rpx;margin-bottom:18rpx;padding:20rpx}.discover-food image{width:190rpx;height:190rpx;border-radius:20rpx;flex:none}.discover-food-main{flex:1;min-width:0}.discover-actions{display:flex;flex-wrap:wrap;gap:10rpx;margin-top:18rpx}.discover-actions button{margin:0;padding:8rpx 14rpx;border-radius:999rpx;font-size:21rpx;line-height:1.5;color:#79552e;background:#fff3df;border:1rpx solid rgba(139,90,43,.16)}.discover-actions button:after{border:0}.discover-ip{display:flex;align-items:center;gap:22rpx;margin-bottom:18rpx;padding:20rpx}.discover-ip image{width:145rpx;height:145rpx;flex:none;border-radius:22rpx;background:#f4eadb}.discover-route{background:linear-gradient(135deg,#fff5df,#f1dfbc)}
.culture-entry{margin-top:20rpx;background:linear-gradient(135deg,#fff1d3,#ead8bb);border:1rpx solid rgba(139,90,43,.14)}.culture-entry-kicker{display:inline-block;padding:6rpx 12rpx;border-radius:999rpx;background:#7b5a8e;color:#fff8ec;font-size:21rpx}.culture-entry .section-title{margin:14rpx 0 8rpx}.culture-entry-action{margin-top:16rpx;color:#8b5a2b;font-weight:800}
.discover-hero{position:relative;overflow:hidden}.discover-hero:after{content:"〰 〰 〰";position:absolute;right:14rpx;bottom:-16rpx;color:rgba(226,195,132,.45);font-size:70rpx;transform:rotate(-7deg)}
.discover-hero:before{content:'河  ·  沿着山河发现';display:block;margin-bottom:8rpx;color:#f0d8a9;font-size:21rpx;letter-spacing:3rpx}.discover-feelings{margin:22rpx 0 4rpx;padding:20rpx;border-radius:24rpx;background:#fffaf1;border:1rpx solid rgba(45,113,128,.12)}.discover-feeling-head{display:flex;justify-content:space-between;color:#3d2c1e;font-size:25rpx;font-weight:800}.discover-feeling-head text:last-child{color:#2d7180;font-size:21rpx;font-weight:500}.feeling-row{display:flex;flex-wrap:wrap;gap:12rpx;margin-top:16rpx}.feeling-row text{padding:10rpx 16rpx;border-radius:999rpx;background:#edf5f3;color:#2d6670;font-size:22rpx}.wine-theme{margin:22rpx 0;padding:24rpx;border-radius:26rpx;background:linear-gradient(135deg,#eee5f2,#d9d8ec);border-left:6rpx solid #6e568d}.wine-theme-kicker{color:#6e568d;font-size:19rpx;letter-spacing:2rpx}.wine-theme-title{margin-top:10rpx;color:#40344d;font-size:29rpx;font-weight:800}.wine-theme-copy{margin-top:8rpx;color:#6e6176;font-size:22rpx;line-height:1.5}.discover-actions button:nth-child(-n+2){display:none}
.discover-hero:before{content:'河  ·  沿着山河发现';display:block;margin-bottom:8rpx;color:#f0d8a9;font-size:21rpx;letter-spacing:3rpx}
.discover-page{position:relative}.discover-page:before{content:"";position:absolute;left:42rpx;top:570rpx;width:3rpx;height:2100rpx;background:linear-gradient(#d4b36f,rgba(212,179,111,.08));opacity:.42;pointer-events:none}.discover-feelings,.culture-entry,.discover-scene-scroll,.wine-theme,.discover-food,.discover-ip,.discover-route{position:relative}.wine-theme-action{margin-top:14rpx;color:#6e568d;font-weight:700}
.discover-scene{width:82vw;margin-right:20rpx}.discover-scene image{width:82vw;height:190rpx}.discover-scene-name{display:-webkit-box;-webkit-box-orient:vertical;-webkit-line-clamp:2;overflow:hidden}.discover-scene .small{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.wine-theme{position:relative;overflow:hidden}.wine-theme:after{content:"⌁  ⌁  ⌁";position:absolute;right:16rpx;bottom:4rpx;color:rgba(110,86,141,.28);font-size:52rpx;letter-spacing:8rpx;transform:rotate(-5deg)}
.river-scene .discover-hero:after{animation:riverFlow 8s ease-in-out infinite}@keyframes riverFlow{50%{opacity:.45;transform:translate(3rpx,-3rpx) rotate(-7deg)}}
.river-spine{display:flex;align-items:center;justify-content:space-between;margin:24rpx 12rpx 8rpx;position:relative;height:76rpx}.river-spine-line{position:absolute;left:5%;right:5%;top:36rpx;height:10rpx;border-radius:50%;background:#d4b36f;transform:rotate(-4deg);box-shadow:0 0 20rpx rgba(212,179,111,.45);animation:riverSpineDraw 1.4s ease both}.river-node{position:relative;z-index:1;width:48rpx;height:48rpx;line-height:48rpx;text-align:center;border:4rpx solid #fffaf1;border-radius:50%;background:#2d7180;color:#fff;font-size:19rpx;box-shadow:0 4rpx 12rpx rgba(45,113,128,.25);animation:riverNodeIn .6s ease both}.river-node:nth-of-type(3){animation-delay:.12s}.river-node:nth-of-type(4){animation-delay:.24s}.river-node:nth-of-type(5){animation-delay:.36s}.river-node:nth-of-type(6){animation-delay:.48s}@keyframes riverSpineDraw{from{transform:scaleX(0) rotate(-4deg);transform-origin:left center;opacity:0}to{transform:scaleX(1) rotate(-4deg);opacity:1}}@keyframes riverNodeIn{from{opacity:0;transform:scale(.4)}to{opacity:1;transform:scale(1)}}
.discovery-worlds{margin:24rpx 0 38rpx;padding:26rpx;border-radius:32rpx;background:linear-gradient(145deg,#f7ead7,#fffaf2);box-shadow:0 18rpx 42rpx rgba(80,54,32,.1)}.world-kicker{color:#8b5a2b;font-size:22rpx;font-weight:800;letter-spacing:3rpx}.world-grid{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-top:20rpx}.world-card{min-height:142rpx;padding:18rpx;border-radius:22rpx;background:rgba(255,255,255,.82);border:2rpx solid transparent;transition:transform .35s ease,border-color .35s ease}.world-card.active{border-color:#8b5a2b;transform:translateY(-6rpx)}.world-icon{font-size:38rpx;color:#8b5a2b}.world-title{margin-top:8rpx;font-size:27rpx;font-weight:900;color:#493426}.world-copy{margin-top:5rpx;color:#8c7460;font-size:20rpx;line-height:1.35}.world-actor{margin-top:10rpx;color:#b07037;font-size:18rpx;letter-spacing:2rpx}.world-action{display:flex;align-items:center;justify-content:space-between;gap:14rpx;margin-top:18rpx;padding-top:18rpx;border-top:1rpx solid rgba(139,90,43,.18);color:#6d503a;font-size:22rpx}.world-action button{margin:0;padding:0 18rpx;color:#fff;background:#175657;border-radius:999rpx;font-size:21rpx}
.discover-section-head{display:flex;align-items:end;justify-content:space-between;margin:30rpx 4rpx 14rpx}.discover-section-head .section-title{color:#174f50;font-size:32rpx;font-weight:900}.section-note{margin-top:5rpx;color:#927b65;font-size:21rpx}.compact-world-grid{margin-top:0;gap:12rpx}.compact-world-grid .world-card{min-height:168rpx;padding:18rpx 16rpx}.compact-world-grid .world-title{font-size:29rpx}.compact-world-grid .world-copy{min-height:54rpx}.selected-head{margin-top:34rpx}
.discover-page:before{display:none}.discover-page{padding-bottom:48rpx}.discover-food{margin-bottom:14rpx}.wine-theme{margin-top:24rpx}.raised-route-theme{margin-top:28rpx;margin-bottom:8rpx}

.discover-page.rtl{text-align:right}.discover-page.rtl .discover-food{direction:rtl}.discover-page.rtl .discover-actions{flex-direction:row-reverse;justify-content:flex-start}
.world-card,.world-card view{min-width:0}.world-title,.world-copy,.world-actor{overflow-wrap:anywhere;word-break:normal}.world-title{line-height:1.35}.world-copy{line-height:1.5}.world-grid{grid-template-columns:repeat(2,minmax(0,1fr))}.world-action{flex-wrap:wrap}.world-action button{min-width:0;height:auto;min-height:70rpx;box-sizing:border-box;padding:10rpx 16rpx;white-space:normal;overflow-wrap:anywhere;word-break:normal}
.en .world-title{font-size:26rpx;line-height:1.3}.en .world-copy{font-size:19rpx;line-height:1.45}.en .compact-world-grid .world-copy{min-height:0}
