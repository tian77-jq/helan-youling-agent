.page{min-height:100vh;padding:48rpx 32rpx;background:#fffaf0}.title{font-size:48rpx;font-weight:800;color:#174f50}.sub{margin:14rpx 0 32rpx;color:#8e7963}.input{width:100%;min-height:180rpx;padding:24rpx;box-sizing:border-box;border-radius:22rpx;background:#fff;border:1rpx solid #eadbc6}.primary{margin-top:24rpx;background:#175657;color:#fff}.error{margin-top:22rpx;color:#b64d3d}.result{margin-top:32rpx;padding:26rpx;border-radius:24rpx;background:#fff;box-shadow:0 8rpx 24rpx rgba(80,50,20,.08)}.result-title{font-size:30rpx;font-weight:700}.constraint-note{margin-top:14rpx;padding:12rpx 16rpx;border-radius:14rpx;background:#eef6ef;color:#3d7058;font-size:23rpx}.profile{margin-top:12rpx;color:#8e7963;font-size:23rpx}.status-tag{display:inline-block;margin-top:12rpx;padding:6rpx 14rpx;border-radius:999rpx;background:#e6f0ea;color:#2f6b55;font-size:21rpx}.day{margin-top:22rpx}.day-title{color:#9b6734;font-weight:700}.item{padding:12rpx 0;color:#5e5144;border-bottom:1rpx solid #f0e4d6}.item-meta{margin-top:6rpx;color:#8e7963;font-size:22rpx}.evidence{margin-top:6rpx;color:#6f8b72;font-size:20rpx}.tip{margin-top:12rpx;color:#9b6734;font-size:22rpx}
