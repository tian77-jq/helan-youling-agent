<view class="page shop-page desert-scene {{isEnglish?'en':''}} {{isRtl?'rtl':''}}" dir="{{isRtl?'rtl':'ltr'}}" data-motion="{{motionToken}}"><view class="shop-hero"><view class="eyebrow">{{ui.brand}}</view><view class="title">{{ui.title}}</view><view class="subtitle">{{ui.subtitle}}</view><view class="shop-note">{{ui.note}}</view></view><view class="dune-exhibition"><view class="dune-copy"><view class="dune-kicker">{{ui.duneKicker}}</view><view class="dune-title">{{ui.reveal}}</view><view class="dune-text">{{ui.intro}}</view></view><view class="dune-horizon"><view class="dune-arc dune-arc-back"></view><view class="dune-arc dune-arc-front"></view><view class="dune-actor dune-actor-goat">🐏</view><view class="dune-actor dune-actor-fox">🦊</view><view class="dune-actor dune-actor-camel">🐫</view></view></view><scroll-view scroll-x class="cat-scroll"><view class="pill-row"><text class="pill {{active===item?'active':''}}" wx:for="{{categories}}" wx:key="*this" data-category="{{item}}" bindtap="filter">{{item}}</text></view></scroll-view><view class="gallery-label">{{ui.gallery}} · {{productList.length}}</view><block wx:for="{{productList}}" wx:key="id"><view class="card product" data-id="{{item.id}}" bindtap="open"><image class="shop-image" src="{{item.image}}" mode="aspectFit"></image><view class="product-main"><view class="product-name">{{item.name}}</view><view class="muted small">{{item.cultureTheme}} · {{ui.title}}</view><view class="status-tag">{{item.status}}</view><view class="muted small">{{item.story}}</view><view class="detail-link">{{ui.detail}}</view><button class="btn btn-secondary" data-id="{{item.id}}" data-name="{{item.name}}" catchtap="favorite">{{item.wished?'♥ '+ui.favorited:'♡ '+ui.favorite}}</button></view></view></block><view wx:if="{{!productList.length}}" class="empty-state">{{ui.note}}</view></view>
