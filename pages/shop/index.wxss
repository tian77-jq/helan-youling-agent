.shop-hero{padding:34rpx 30rpx;border-radius:32rpx;background:linear-gradient(135deg,#7a512d,#b17b45);color:#fff8ec;box-shadow:0 16rpx 34rpx rgba(104,67,35,.2)}.shop-hero .title{margin:10rpx 0;font-size:46rpx;font-weight:800}.shop-hero .subtitle{font-size:26rpx;line-height:1.7;color:rgba(255,248,236,.9)}
.cat-scroll{white-space:nowrap;margin:28rpx 0}.cat-scroll .pill-row{display:inline-flex}.cat-scroll .pill{white-space:nowrap}.product{display:flex;gap:20rpx;margin-bottom:18rpx;padding:20rpx}.shop-image{width:230rpx;height:230rpx;flex:none;border-radius:24rpx;background:#f7f0e6}.product-main{flex:1;min-width:0}.product-name{font-weight:700;font-size:30rpx;color:#3f2c1d}.status-tag{display:inline-block;margin:14rpx 0;padding:6rpx 12rpx;border-radius:999rpx;background:#f0dfbd;color:#8a5d2d;font-size:21rpx}.detail-link{margin-top:14rpx;color:#9a6938;font-size:23rpx;font-weight:600}.product-main .btn{font-size:24rpx;padding:14rpx 18rpx;margin-top:16rpx}.empty-state{margin-top:26rpx;padding:36rpx 24rpx;text-align:center;color:#897967;background:rgba(139,90,43,.06);border-radius:24rpx}
.shop-hero{position:relative;overflow:hidden}.shop-hero:after{content:"◌  ·  ◌  ·  ◌";position:absolute;right:12rpx;bottom:-2rpx;color:rgba(255,235,190,.35);font-size:48rpx;letter-spacing:8rpx}
.shop-hero:before{content:'沙  ·  把宁夏带走';display:block;margin-bottom:8rpx;color:#f4dbad;font-size:21rpx;letter-spacing:3rpx}
.shop-page{position:relative}.shop-page .cat-scroll{padding-bottom:4rpx}.shop-page .product{border-left:4rpx solid rgba(139,90,43,.16)}.shop-page .product-main .muted.small{line-height:1.5}.shop-page .status-tag{font-size:19rpx}.shop-page .detail-link{font-size:24rpx}
.shop-note{margin-top:12rpx;color:rgba(255,248,236,.68);font-size:20rpx}.shop-page .product-main .btn{background:#f3e5cf;color:#8b5a2b}
.shop-page{background:linear-gradient(180deg,#f8efe1 0%,#eee0ce 100%)}.shop-hero{background:linear-gradient(145deg,#79502c,#a97542)}.shop-hero:after{content:"⌁  ·  ◌  ·  ⌁";font-size:38rpx}.shop-page .cat-scroll{margin:22rpx 0 30rpx}.shop-page .pill-row{gap:14rpx}.shop-page .product{background:rgba(255,253,248,.9);box-shadow:0 10rpx 24rpx rgba(83,56,32,.08)}
.desert-scene .product{animation:desertReveal .5s ease both}@keyframes desertReveal{from{opacity:0;transform:translateY(12rpx)}to{opacity:1;transform:translateY(0)}}
.dune-exhibition{position:relative;min-height:300rpx;margin:20rpx 0 12rpx;overflow:hidden;border-radius:30rpx;background:linear-gradient(180deg,#f3e5cf,#c9894e);box-shadow:0 16rpx 30rpx rgba(111,72,38,.16)}.dune-copy{position:relative;z-index:2;padding:28rpx 24rpx;color:#fffaf1}.dune-kicker{font-size:19rpx;letter-spacing:2rpx;color:#ffe4b0}.dune-title{margin-top:12rpx;font-size:34rpx;font-weight:900}.dune-text{margin-top:10rpx;width:78%;font-size:22rpx;line-height:1.55;color:rgba(255,250,241,.86)}.dune-horizon{position:absolute;left:0;right:0;bottom:0;height:175rpx}.dune-arc{position:absolute;left:-12%;width:124%;height:170rpx;border-radius:55% 45% 0 0;transform:rotate(-5deg)}.dune-arc-back{bottom:-88rpx;background:#e6bd7f}.dune-arc-front{bottom:-112rpx;background:#7a512d}.dune-actor{position:absolute;z-index:3;font-size:46rpx;filter:drop-shadow(0 5rpx 4rpx rgba(74,45,24,.2));animation:duneActorReveal 1.2s ease both}.dune-actor-goat{left:18%;bottom:28rpx}.dune-actor-fox{left:46%;bottom:46rpx;animation-delay:.18s}.dune-actor-camel{right:15%;bottom:26rpx;animation-delay:.36s}@keyframes duneActorReveal{from{opacity:0;transform:translateY(60rpx)}to{opacity:1;transform:translateY(0)}}.gallery-label{margin:16rpx 4rpx;color:#79552e;font-size:22rpx;font-weight:800;letter-spacing:1rpx}

.shop-page.rtl{text-align:right}.shop-page.rtl .product{direction:rtl}.shop-page.rtl .dune-horizon{direction:ltr;unicode-bidi:isolate}
