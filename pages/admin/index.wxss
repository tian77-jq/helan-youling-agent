.my-hero{display:flex;align-items:center;gap:20rpx;padding:34rpx 30rpx;border-radius:32rpx;background:linear-gradient(135deg,#174f50,#8a6038);color:#fff8ec}.avatar{width:92rpx;height:92rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;font-size:52rpx;background:rgba(255,255,255,.18)}.my-hero .title{font-size:42rpx;font-weight:800}.my-hero .subtitle{margin-top:8rpx;color:rgba(255,248,236,.8);font-size:24rpx}.my-section{margin-top:28rpx}.my-trip{background:linear-gradient(135deg,#fff5df,#f0dfbd)}.my-grid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx;margin-top:18rpx}.my-entry{padding:24rpx}.my-entry view{font-size:40rpx;color:#9a6a35}.my-entry text{display:block;margin-top:10rpx;font-size:27rpx;font-weight:700}.my-entry small{display:block;margin-top:6rpx;color:#8a7967}.wish-card,.pet-card{margin-top:18rpx}.wish-card .link-btn{margin-top:14rpx;color:#8b5a2b;font-weight:700}.pet-row{display:flex;gap:12rpx;flex-wrap:wrap}.pet-choice{padding:14rpx 18rpx;border-radius:999rpx;background:#f7ecdb;color:#725638}.pet-choice.active{color:#fff;background:#8b5a2b}.service-list{padding:8rpx 24rpx}.service-list view{display:flex;justify-content:space-between;padding:24rpx 0;border-bottom:1rpx solid rgba(139,90,43,.1);font-size:27rpx}.service-list view:last-child{border:0}.service-list text{color:#9b8771;font-size:22rpx}
.my-hero{position:relative;overflow:hidden;background:linear-gradient(135deg,#1f3d55,#6b6288)}.my-hero:after{content:"✦  ·  ✦";position:absolute;right:20rpx;top:18rpx;color:rgba(255,244,210,.6);letter-spacing:12rpx;animation:myStars 5s ease-in-out infinite}@keyframes myStars{50%{opacity:.35;transform:translateY(5rpx)}}
.my-page > .my-section:nth-of-type(2){display:none}.my-hero .title{font-size:0}.my-hero .title:after{content:'我的宁夏';font-size:42rpx}.my-hero .subtitle{font-size:0}.my-hero .subtitle:after{content:'把走过的路、读过的故事和留下的灵感收在这里';font-size:24rpx;color:#9a7957}
.my-hero:before{content:'星  ·  记住宁夏';position:absolute;left:30rpx;bottom:18rpx;color:rgba(255,244,210,.72);font-size:20rpx;letter-spacing:3rpx}
.my-page > .my-section:nth-of-type(2){display:block}.my-page > .my-section:nth-of-type(3){display:none}
.my-page{background:linear-gradient(180deg,#f7eee2,#efe2d0)}.my-hero{min-height:150rpx}.avatar{font-size:0}.avatar:after{content:'◒';font-size:48rpx;color:#f2d5a2}.my-page > .my-section:nth-of-type(3){display:none}.my-page > .my-section:nth-of-type(2){display:block}.badge-row>text{font-size:0}.badge-row>text:after{content:'⌁';font-size:34rpx;color:#947044}
.star-scene .my-hero:after{animation:myStars 5s ease-in-out infinite}
.my-page > .my-section{display:block!important}
.star-atlas-hero{position:relative;overflow:hidden;margin-bottom:22rpx;padding:28rpx 24rpx 20rpx;border-radius:34rpx;background:radial-gradient(circle at 76% 18%,#526b91,#1b3247 52%,#102333);color:#fff8ec;box-shadow:0 20rpx 40rpx rgba(16,35,51,.28)}.atlas-kicker{color:#eacb91;font-size:19rpx;letter-spacing:2rpx}.atlas-title{margin-top:10rpx;font-size:31rpx;font-weight:900;line-height:1.4}.atlas-landscape{height:300rpx;position:relative;margin:4rpx -24rpx 0;overflow:hidden}.atlas-landscape:before{content:'✦  ·  ✦     ·   ✦';position:absolute;inset:25rpx;color:rgba(255,231,168,.8);font-size:23rpx;letter-spacing:18rpx}.atlas-dune{position:absolute;left:-10%;width:120%;border-radius:55% 55% 0 0;transform:skewX(-12deg)}.dune-back{bottom:82rpx;height:125rpx;background:#496276}.dune-front{bottom:0;height:150rpx;background:#172d3d}.landscape-river .dune-back{background:#386877}.landscape-river .atlas-river{position:absolute;left:-5%;right:-5%;bottom:72rpx;height:42rpx;background:#e6c67f;transform:rotate(-5deg);border-radius:50%}.landscape-desert .dune-back{background:#9a714d}.landscape-desert .dune-front{background:#5b3d2f}.atlas-constellation{position:absolute;inset:0;z-index:2}.atlas-star{position:absolute;color:#e8c77e;font-size:34rpx;text-shadow:0 0 16rpx #e8c77e;animation:atlasTwinkle 2.8s ease-in-out infinite}.atlas-star text{display:block;font-size:16rpx}.atlas-star:nth-child(1){left:9%;top:35%}.atlas-star:nth-child(2){left:25%;top:18%}.atlas-star:nth-child(3){left:43%;top:42%}.atlas-star:nth-child(4){left:61%;top:22%}.atlas-star:nth-child(5){right:10%;top:46%}.atlas-star.lit{color:#fff0a8;font-size:43rpx}.atlas-copy{color:rgba(255,248,236,.72);font-size:21rpx}.region-portals{display:grid;grid-template-columns:repeat(3,1fr);gap:14rpx;margin:18rpx 0}.portal{padding:18rpx 12rpx;border-radius:24rpx;background:#f9efe0;color:#76563a;text-align:center}.portal.active{color:#fff;background:#285b61;transform:translateY(-5rpx)}.portal text{display:block;font-size:39rpx;font-weight:900}.portal small{display:block;font-size:17rpx}.atlas-section{padding:20rpx 4rpx 4rpx}.atlas-intro{margin-top:7rpx;color:#806d5b;font-size:22rpx}.star-legend{display:flex;gap:16rpx;margin-top:13rpx;color:#947044;font-size:19rpx}.memory-reentry{background:linear-gradient(135deg,#fff5df,#f0dfbd)}.star-detail-mask{position:fixed;z-index:20;inset:0;display:flex;align-items:flex-end;background:rgba(14,31,44,.48)}.star-detail{width:100%;box-sizing:border-box;padding:34rpx 30rpx 52rpx;border-radius:34rpx 34rpx 0 0;background:#fff8ec}.star-detail-title{margin-top:9rpx;color:#174f50;font-size:38rpx;font-weight:900}.star-detail-copy{margin:20rpx 0;color:#725f4c;font-size:24rpx;line-height:1.6}@keyframes atlasTwinkle{50%{opacity:.48;transform:scale(1.22)}}
.star-map{position:relative;overflow:hidden;margin:22rpx 0;padding:26rpx 24rpx 18rpx;border-radius:30rpx;background:radial-gradient(circle at 75% 25%,#4d6686,#1f3d55 52%,#172c3d);color:#fff8ec;box-shadow:0 18rpx 32rpx rgba(31,61,85,.24)}.star-map-kicker{font-size:19rpx;letter-spacing:2rpx;color:#f0d8a9}.star-map-title{margin-top:10rpx;font-size:30rpx;font-weight:900;line-height:1.4}.star-field{height:190rpx;position:relative;margin-top:8rpx}.memory-orbit{position:absolute;left:16%;top:22%;width:68%;height:58%;border:2rpx solid rgba(240,216,169,.35);border-radius:50%;transform:rotate(-18deg)}.memory-star{position:absolute;z-index:2;color:#f7d895;font-size:38rpx;text-shadow:0 0 18rpx #f7d895;animation:starPulse 2.6s ease-in-out infinite}.memory-star text{display:block;margin-top:-5rpx;color:rgba(255,248,236,.75);font-size:18rpx;text-shadow:none}.star-one{left:12%;top:35%}.star-two{left:47%;top:12%;animation-delay:.5s}.star-three{right:12%;top:52%;animation-delay:1s}.star-map-copy{font-size:21rpx;color:rgba(255,248,236,.72)}@keyframes starPulse{50%{opacity:.55;transform:scale(1.22)}}
.profile-header{display:flex;align-items:center;gap:16rpx;margin-bottom:18rpx;padding:18rpx 20rpx;border-radius:24rpx;background:rgba(255,250,241,.9)}.profile-avatar{width:68rpx;height:68rpx;display:flex;align-items:center;justify-content:center;border-radius:50%;background:#ead6b4;font-size:34rpx}.profile-copy{flex:1}.profile-name{color:#304f48;font-size:27rpx;font-weight:800}.profile-sub{margin-top:4rpx;color:#927c66;font-size:19rpx}.profile-scan{margin:0;padding:8rpx 18rpx;border-radius:999rpx;background:#23554e;color:#fff8ed;font-size:21rpx;line-height:1.5}.profile-scan:after{border:0}
.profile-shortcuts{display:grid;grid-template-columns:1fr 1fr;gap:14rpx;margin-bottom:20rpx}.profile-shortcuts>view{display:flex;align-items:center;gap:14rpx;padding:20rpx 24rpx;border-radius:24rpx;background:#fffaf1;color:#31504b;box-shadow:0 8rpx 18rpx rgba(77,54,29,.07)}.profile-shortcuts text{font-size:34rpx;color:#a56e38}.profile-shortcuts label{font-size:26rpx;font-weight:800}

.my-page.rtl{text-align:right}.my-page.rtl .portal,.my-page.rtl .atlas-star{text-align:right}.my-page.rtl .atlas-landscape,.my-page.rtl .constellation{direction:ltr;unicode-bidi:isolate}
.my-page .my-hero,.my-page .profile-copy,.my-page .my-entry,.my-page .service-list view{min-width:0}.my-page .my-entry text,.my-page .my-entry small,.my-page .atlas-title,.my-page .atlas-copy,.my-page .profile-sub{overflow-wrap:anywhere;word-break:normal;line-height:1.4}.my-page button{max-width:100%;height:auto;min-height:72rpx;box-sizing:border-box;padding:10rpx 16rpx;line-height:1.35;white-space:normal;overflow-wrap:anywhere;word-break:normal}.my-grid{grid-template-columns:repeat(2,minmax(0,1fr))}
.en .star-atlas-hero,.en .star-map,.en .memory-reentry,.en .profile-header,.en .my-entry{min-width:0;overflow-wrap:anywhere}.en .region-portals{grid-template-columns:repeat(3,minmax(0,1fr))}.en .portal{min-width:0;padding-inline:8rpx}.en .portal small{line-height:1.3;overflow-wrap:anywhere}.en .service-list view{gap:12rpx}.en .service-list view text{min-width:0;overflow-wrap:anywhere}
