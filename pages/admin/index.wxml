<view class="page my-page star-scene {{isRtl?'rtl':''}} {{isEnglish?'en':''}}" dir="{{isRtl?'rtl':'ltr'}}" data-motion="{{motionToken}}" data-motion-mode="{{motionMode}}">
  <button wx:if="{{hostContext}}" bindtap="returnToHost">{{ui.returnToScenic}} ? {{hostContext.scenicName}}</button>
  <view class="profile-header"><view class="profile-avatar">🐏</view><view class="profile-copy"><view class="profile-name">{{ui.profile}}</view><view class="profile-sub">{{ui.subtitle}}</view></view><button class="profile-scan" bindtap="scan">{{ui.scan}}</button></view>
  <view class="profile-shortcuts"><view bindtap="openSettings"><text>⚙</text><label>{{ui.settings}}</label></view><view bindtap="openMall"><text>◇</text><label>{{ui.mall}}</label></view></view>
  <view class="star-atlas-hero"><view class="atlas-kicker">{{ui.atlas}}</view><view class="atlas-title">{{ui.atlasTitle}}</view><view class="atlas-landscape landscape-{{activeRegion.regionId}}"><view class="atlas-dune dune-back"></view><view class="atlas-dune dune-front"></view><view class="atlas-river"></view><view class="atlas-constellation"><view wx:for="{{stars}}" wx:key="memoryId" class="atlas-star {{item.state==='SAVED'?'lit':''}}" data-id="{{item.memoryId}}" bindtap="openStar">✦<text>{{item.label}}</text></view></view></view><view class="atlas-copy">{{ui.memories}} · {{memoryCount}}</view></view>
  <view class="region-portals"><view class="portal {{activeRegion.regionId==='mountain'?'active':''}}" data-id="mountain" bindtap="switchRegion" aria-label="{{ui.portalMountain}}"><text>⛰</text><small>{{ui.portalMountain}}</small></view><view class="portal {{activeRegion.regionId==='river'?'active':''}}" data-id="river" bindtap="switchRegion" aria-label="{{ui.portalRiver}}"><text>≋</text><small>{{ui.portalRiver}}</small></view><view class="portal {{activeRegion.regionId==='desert'?'active':''}}" data-id="desert" bindtap="switchRegion" aria-label="{{ui.portalDesert}}"><text>◒</text><small>{{ui.portalDesert}}</small></view></view>
  <view class="atlas-section"><view class="section-title">{{activeRegion.label}}之境 · Memory Constellation</view><view class="atlas-intro">{{activeRegion.emptyState}}</view><view class="star-legend"><text>{{ui.savedStatus}}</text><text>{{ui.plannedStatus}}</text><text>{{ui.discoveryStatus}}</text></view></view>
  <view class="section my-section"><view class="section-title">{{ui.continueJourney}}</view><view class="card my-trip"><view class="product-name">{{tripTitle}}</view><view class="muted">{{tripCopy}}</view><button class="btn btn-full" bindtap="openTrip">{{hasTrip?ui.viewContinuePlan:ui.planWithAi}}</button></view></view>
  <view class="section my-section"><view class="section-title">{{ui.memories}} · {{memoryCount}}</view><view class="card memory-reentry"><view class="muted">{{ui.atlasTitle}}</view><button class="btn btn-full" bindtap="openMemories">{{ui.generateMemory}}</button></view></view>
  <view class="section my-section"><view class="card service-list"><view bindtap="openWishlist">{{ui.favorites}} <text>{{wishCount}} →</text></view><view bindtap="openLanguage">{{ui.language}} <text>{{localeLabel}} →</text></view><view bindtap="privacy">{{ui.privacy}}</view><view bindtap="clearLocalData">{{ui.clear}}</view></view></view>
  <view wx:if="{{activeStar}}" class="star-detail-mask" bindtap="closeStar"><view class="star-detail" catchtap="noop"><view class="atlas-kicker">{{activeStar.state}}</view><view class="star-detail-title">{{activeStar.label}}</view><view class="muted">{{activeStar.memoryType}} · {{activeStar.character}}</view><view class="star-detail-copy">{{ui.starDetailCopy}}</view><button class="btn btn-full" bindtap="askMemoryAI">{{ui.continueWithCompanion}}</button><button class="btn btn-full" bindtap="openTrip">{{ui.rejoinTrip}}</button><button class="btn btn-full" bindtap="openMemories">{{ui.generateMemory}}</button></view></view>
</view>
