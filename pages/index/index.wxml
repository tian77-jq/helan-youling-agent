<view class="home-page mountain-scene {{isRtl?'rtl':''}} {{isEnglish?'en':''}}" dir="{{isRtl?'rtl':'ltr'}}" data-motion="{{motionToken}}" data-motion-mode="{{motionMode}}">
  <view class="ningxia-hero {{heroEntering ? 'hero-entering' : ''}}">
    <image class="hero-landscape" src="/assets/thumbs/banners/ningxia-hero-v1.jpg" mode="aspectFill" bindload="onHeroLoad" binderror="onHeroError" aria-label="宁夏山河原创意象：贺兰山、黄河与岩羊、双峰驼、沙狐"></image>
    <view class="hero-heading"><view class="hero-eyebrow">{{ui.eyebrow}}</view><view class="hero-title">{{ui.title}}</view><view class="hero-subtitle">{{ui.subtitle}}</view></view>
    <view wx:if="{{heroImageFailed}}" class="hero-fallback">{{ui.fallback}}</view>
    <view class="hero-caption">{{ui.caption}}</view>
    <view class="hero-credit">{{ui.credit}}</view>
  </view>
  <view class="trip-unified-card"><view class="trip-card-head"><view><view class="trip-card-kicker">{{ui.tripKicker}}</view><view class="trip-card-title">{{ui.tripTitle}}</view></view><text class="trip-card-route">〰→</text></view><view class="trip-card-actions"><button bindtap="newTrip">{{ui.newTrip}}</button><button class="resume-action" bindtap="openCreate">{{ui.create}}</button><button wx:if="{{hasTrip}}" class="resume-action" bindtap="resumeTrip">{{ui.resumeTrip}}</button><view wx:else class="resume-disabled">{{ui.noTrip}}</view></view></view>
  <view class="home-destinations"><view class="home-section-label">{{ui.quick}}</view><view class="persona-discovery-list"><view wx:for="{{entries}}" wx:key="id" class="persona-discovery-card actor-{{item.id}}" data-url="{{item.url}}" bindtap="openEntry"><image class="persona-discovery-image" src="{{item.image}}" mode="aspectFill" lazy-load></image><view class="persona-discovery-content"><view class="persona-discovery-title">{{item.title}}</view><view class="persona-discovery-copy">{{item.copy}}</view></view><text class="persona-discovery-arrow">→</text></view></view></view>
  <view class="home-story-hero"><view class="home-story-kicker">{{ui.qaKicker}}</view><view class="home-story-title">{{ui.qaTitle}}</view><view class="home-story-copy">{{ui.qaCopy}}</view><scroll-view scroll-x class="home-story-scroll"><block wx:for="{{stories}}" wx:key="storyId"><view class="home-story-card" data-id="{{item.storyId}}" bindtap="openStory"><view class="home-story-theme">{{item.theme}}</view><view class="home-story-name">{{item.title}}</view><view class="home-story-arrow">{{ui.ask}}</view></view></block></scroll-view><view class="story-scroll-hint"><text>{{ui.scrollHint}}</text></view></view><view class="home-note">{{ui.note}}</view><view wx:if="{{onboardingVisible}}" class="home-onboarding" bindtap="dismissOnboarding"><view class="onboarding-card" catchtap="dismissOnboarding"><view class="onboarding-star">✦</view><view class="onboarding-title">{{ui.subtitle}}</view><view class="onboarding-copy">{{ui.newTrip}}</view><view class="onboarding-action">{{ui.resumeTrip}} →</view></view></view>
</view>
