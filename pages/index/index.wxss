.home-page{min-height:100vh;padding:0 32rpx 48rpx;box-sizing:border-box;background:#fff8ee;color:#3b3026}
.ningxia-hero{position:relative;height:750rpx;margin:0 -32rpx;overflow:hidden;background:#e7dac6}
.hero-landscape{position:absolute;inset:0;width:100%;height:100%;transform:scale(1)}
.hero-heading{position:absolute;top:32rpx;left:32rpx;right:32rpx;text-align:center;color:#29443c}
.hero-eyebrow{font-size:19rpx;letter-spacing:5rpx;color:#606352}.hero-title{margin-top:7rpx;font-family:serif;font-size:72rpx;font-weight:800;letter-spacing:12rpx;line-height:1.25}.hero-subtitle{margin-top:12rpx;font-size:24rpx;letter-spacing:4rpx;color:#56533f}
.hero-caption,.hero-credit{position:absolute;bottom:18rpx;padding:6rpx 12rpx;border-radius:8rpx;background:rgba(39,35,28,.65);color:#fff7e9;font-size:17rpx;line-height:1.5}.hero-caption{left:24rpx}.hero-credit{right:24rpx;font-size:16rpx}.hero-fallback{position:absolute;top:55%;width:100%;text-align:center;color:#3b5045;font-size:24rpx}
.hero-entering .hero-landscape{animation:heroLandscapeIn 1.6s cubic-bezier(.2,.65,.3,1) both}.hero-entering .hero-heading{animation:heroHeadingIn 1.1s ease-out both}
@keyframes heroLandscapeIn{from{transform:scale(1.035)}to{transform:scale(1)}}@keyframes heroHeadingIn{from{opacity:.45;transform:translateY(10rpx)}to{opacity:1;transform:translateY(0)}}
[data-motion-mode="REDUCED"] .hero-landscape,[data-motion-mode="OFF"] .hero-landscape,[data-motion-mode="REDUCED"] .hero-heading,[data-motion-mode="OFF"] .hero-heading{animation:none}
.motion-reduced .hero-entering .hero-landscape,.motion-reduced .hero-entering .hero-heading,.motion-off .hero-entering .hero-landscape,.motion-off .hero-entering .hero-heading{animation:none}
.trip-unified-card{margin:24rpx 0;padding:24rpx;border-radius:28rpx;background:linear-gradient(135deg,#174f50,#356f63);color:#fff8ec;box-shadow:0 14rpx 28rpx rgba(22,71,65,.18)}.trip-card-head{display:flex;align-items:center;justify-content:space-between}.trip-card-kicker{font-size:18rpx;letter-spacing:2rpx;color:#f0d8a9}.trip-card-title{margin-top:8rpx;font-size:36rpx;font-weight:900}.trip-card-route{font-size:48rpx;color:#f0d8a9}.trip-card-actions{display:flex;align-items:center;gap:12rpx;margin-top:20rpx}.trip-card-actions button{flex:1;margin:0;padding:14rpx 10rpx;border:0;border-radius:999rpx;background:#f0d8a9;color:#31504b;font-size:23rpx}.trip-card-actions .resume-action{background:#fffaf1}.resume-disabled{flex:1;padding:14rpx 10rpx;border-radius:999rpx;background:rgba(255,255,255,.14);color:rgba(255,248,236,.66);font-size:21rpx;text-align:center}
.home-destinations{margin:28rpx 0}.home-section-label{color:#76583f;font-size:22rpx;font-weight:800}.persona-discovery-list{margin-top:12rpx}.persona-discovery-card{display:flex;align-items:center;gap:18rpx;margin-top:12rpx;padding:20rpx;border-radius:24rpx;box-shadow:0 8rpx 20rpx rgba(77,54,29,.08)}.actor-yanYang{background:linear-gradient(135deg,#175657,#2e7770)}.actor-luoTuo{background:linear-gradient(135deg,#6d4a31,#9c6a3b)}.actor-shaHu{background:linear-gradient(135deg,#a56e38,#c98743)}.persona-discovery-image{width:92rpx;height:92rpx;flex:none;border-radius:22rpx;background:#d8e6d9}.persona-discovery-content{flex:1}.persona-discovery-title{font-size:28rpx;font-weight:900;color:#fff8ee}.persona-discovery-copy{margin-top:7rpx;color:#fff1dc;font-size:21rpx}.persona-discovery-arrow{margin-left:auto;color:#ffe3ad;font-size:30rpx}
.home-story-hero{margin:20rpx 24rpx;padding:26rpx 22rpx;border-radius:28rpx;background:linear-gradient(145deg,#fff4db,#ead7bc);overflow:hidden}.home-story-kicker{color:#7b5a8e;font-size:21rpx}.home-story-title{margin-top:12rpx;font-size:34rpx;font-weight:800;color:#4b392b}.home-story-copy{margin-top:8rpx;color:#765f4a;font-size:24rpx}.home-story-scroll{white-space:nowrap;margin-top:20rpx}.home-story-card{display:inline-block;vertical-align:top;width:270rpx;min-height:150rpx;margin-right:14rpx;padding:18rpx;border-radius:22rpx;background:#fffaf1;box-sizing:border-box}.home-story-theme{font-size:20rpx;color:#8b5a2b}.home-story-name{margin-top:12rpx;white-space:normal;font-weight:700;color:#4b392b;line-height:1.45}.home-story-arrow{margin-top:14rpx;color:#7b5a8e;font-size:21rpx}.story-scroll-hint{margin-top:12rpx;text-align:center;color:#9a7957;font-size:19rpx}.home-note{margin-top:42rpx;text-align:center;color:#a18b75;font-size:21rpx}
.home-onboarding{margin-top:24rpx}.onboarding-card{position:relative;padding:34rpx 28rpx;border-radius:28rpx;background:#fffaf0;text-align:center;box-shadow:0 20rpx 48rpx rgba(30,60,50,.25)}.onboarding-star{color:#c68b49;font-size:48rpx}.onboarding-title{margin-top:8rpx;color:#174f50;font-size:32rpx;font-weight:900}.onboarding-copy{margin-top:10rpx;color:#806d5b;font-size:23rpx}.onboarding-action{margin-top:24rpx;color:#8b5a2b;font-weight:800}

.trip-card-actions{flex-wrap:wrap}.trip-card-actions button,.trip-card-actions .resume-disabled{min-width:0;white-space:normal;line-height:1.35;overflow-wrap:anywhere}.home-page.rtl .persona-discovery-arrow{margin-left:0;margin-right:auto}.home-page.rtl .trip-card-route{direction:ltr;unicode-bidi:isolate}
.persona-discovery-content{min-width:0;flex:1}.persona-discovery-title{line-height:1.35;overflow-wrap:anywhere;word-break:normal}.persona-discovery-copy{line-height:1.45;overflow-wrap:anywhere;word-break:normal}.trip-card-head>view{min-width:0;flex:1}.trip-card-actions button{flex:1 1 42%;min-width:0;height:auto;min-height:76rpx;box-sizing:border-box;padding:12rpx 16rpx;line-height:1.35;white-space:normal;overflow-wrap:anywhere;word-break:normal}.hero-heading{left:24rpx;right:24rpx}.hero-title{max-width:100%;font-size:68rpx;letter-spacing:8rpx;overflow-wrap:anywhere}.hero-subtitle{line-height:1.45;overflow-wrap:anywhere;word-break:normal}
.en .hero-title{font-size:58rpx;letter-spacing:2rpx;line-height:1.2}.en .trip-card-actions button{font-size:22rpx}.en .home-story-card{width:300rpx;white-space:normal}.en .home-story-name{overflow-wrap:anywhere;word-break:normal;line-height:1.4}
.hero-title{font-size:68rpx;letter-spacing:8rpx}.en .hero-title{font-size:58rpx;letter-spacing:2rpx}
