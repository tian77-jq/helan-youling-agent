.host-return-page{min-height:100vh;box-sizing:border-box;padding:56rpx 32rpx;background:#f8f1e7;color:#294e4a}.host-return-kicker{color:#9b7040;font-size:20rpx;letter-spacing:2rpx}.host-return-title{margin-top:22rpx;font-size:42rpx;font-weight:900}.host-return-copy{margin:18rpx 0 36rpx;color:#806d5b;font-size:25rpx}.host-return-page button{margin:18rpx 0;background:#23554e;color:#fff8ed;border-radius:999rpx}.host-return-page button:after{border:0}.host-return-page .ghost{background:#ead9bf;color:#76563a}
