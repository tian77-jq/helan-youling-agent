.page{min-height:100vh;padding:48rpx 32rpx;background:#fffaf0}.title{font-size:48rpx;font-weight:800;color:#9b6734}.sub{margin:14rpx 0 24rpx;color:#8e7963}.choices{display:flex;flex-wrap:wrap;gap:12rpx}.choices button{margin:0;padding:0 18rpx;font-size:23rpx;background:#fff;border:1rpx solid #eadbc6}.input{width:100%;min-height:150rpx;margin-top:26rpx;padding:24rpx;box-sizing:border-box;border-radius:22rpx;background:#fff;border:1rpx solid #eadbc6}.ai-notice,.ai-label{margin-top:16rpx;padding:12rpx 16rpx;border-radius:14rpx;background:#fff0d8;color:#705538;font-size:21rpx;line-height:1.5}.primary{margin-top:24rpx;background:#9b6734;color:#fff}.error{margin-top:22rpx;color:#b64d3d}.art-card,.prompt-card{margin-top:30rpx;padding:26rpx;border-radius:22rpx;background:#fff;border:1rpx solid #eadbc6;line-height:2;color:#5e5144}.art-image{width:100%;display:block;border-radius:16rpx;margin:20rpx 0}.source{margin-top:12rpx;color:#9b6734;font-size:22rpx}.hint{margin-top:16rpx;color:#9b6734;font-size:22rpx}
.choices button,.primary,.art-card button{box-sizing:border-box;max-width:100%;min-width:0;min-height:76rpx;height:auto;padding:12rpx 20rpx;line-height:1.35;white-space:normal;overflow-wrap:anywhere;word-break:normal}.page .title,.page .sub,.page button,.page view{min-width:0;overflow-wrap:anywhere;word-break:normal}.art-composition{position:relative;overflow:hidden;border-radius:16rpx}.art-composition .art-image{margin:0;border-radius:0}.composition-overlay{position:absolute;left:0;right:0;bottom:0;box-sizing:border-box;padding:28rpx 24rpx 24rpx;background:linear-gradient(180deg,rgba(0,0,0,0),rgba(0,0,0,.78));color:#fff;direction:inherit;text-align:start}.composition-title{font-size:32rpx;font-weight:800;line-height:1.35;overflow-wrap:anywhere}.composition-meta,.composition-quote,.composition-date{margin-top:8rpx;font-size:22rpx;line-height:1.45;overflow-wrap:anywhere;word-break:normal}
