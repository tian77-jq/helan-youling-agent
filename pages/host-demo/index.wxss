.host-demo{min-height:100vh;padding:30rpx;background:#edf2ef;color:#244643;box-sizing:border-box}.host-label{font-size:30rpx;font-weight:900}.host-note{margin-top:8rpx;color:#9a7655;font-size:20rpx}.host-header{display:flex;justify-content:space-between;margin:28rpx 0 18rpx;padding:22rpx;background:#fff;border-radius:18rpx;font-size:21rpx}.host-brand{font-weight:800}.scenic-hero{padding:34rpx 28rpx;border-radius:28rpx;background:linear-gradient(145deg,#174f50,#557d72);color:#fff8ec}.scenic-tag,.ai-kicker{font-size:19rpx;letter-spacing:2rpx;color:#f0d8a9}.scenic-title{margin-top:14rpx;font-size:54rpx;font-weight:900}.scenic-city{margin-top:8rpx;font-size:23rpx}.scenic-intro{margin-top:28rpx;line-height:1.6;color:rgba(255,248,236,.8)}.service-grid{display:grid;grid-template-columns:repeat(4,1fr);gap:10rpx;margin:18rpx 0}.service{padding:18rpx 5rpx;border-radius:16rpx;background:#fff;text-align:center;font-size:20rpx}.ai-module{margin-top:28rpx;padding:28rpx;border-radius:26rpx;background:#fff4dc;box-shadow:0 10rpx 24rpx rgba(68,87,68,.1)}.ai-title{margin-top:9rpx;font-size:40rpx;font-weight:900;color:#174f50}.ai-copy{margin:9rpx 0 20rpx;color:#806d5b;font-size:23rpx;line-height:1.5}.ai-module button{border:0;border-radius:999rpx;background:#174f50;color:#fff;font-size:26rpx}.back{margin-top:22rpx;background:transparent;color:#806d5b;font-size:22rpx}
